{
  "name": "wunder-virtual-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Wunder Sa.Bi. scales showroom: a walkable virtual world rendered entirely in WebGL.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/make-artifact.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
